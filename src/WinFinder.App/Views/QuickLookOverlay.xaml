<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinFinder.App.Views.QuickLookOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Scrim" Background="#99000000" Tapped="Scrim_Tapped">
        <Border x:Name="Card"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="12" BorderThickness="1"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                Tapped="Card_Tapped">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: close, full screen, title, open -->
                <Grid Padding="10,6,10,6" ColumnSpacing="6"
                      Background="{ThemeResource LayerFillColorAltBrush}"
                      BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CloseButton" Click="Close_Click" ToolTipService.ToolTip="Close (Space)"
                            Background="Transparent" BorderThickness="0" Padding="6">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="1" x:Name="FullScreenButton" Click="FullScreen_Click" ToolTipService.ToolTip="Full Screen"
                            Background="Transparent" BorderThickness="0" Padding="6">
                        <FontIcon x:Name="FullScreenGlyph" Glyph="&#xE740;" FontSize="12" />
                    </Button>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                        <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="OpenButton" Click="Open_Click" Content="Open" />
                </Grid>

                <Grid x:Name="ContentHost" Grid.Row="1">
                    <Image x:Name="ImageView" Stretch="Uniform" Margin="8" Visibility="Collapsed" />

                    <ScrollViewer x:Name="TextScroller" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                        <TextBlock x:Name="TextView" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                   Margin="16" IsTextSelectionEnabled="True" />
                    </ScrollViewer>

                    <StackPanel x:Name="FallbackView" Visibility="Collapsed" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="10" Padding="32">
                        <Image x:Name="FallbackIcon" Width="160" Height="160" Stretch="Uniform" />
                        <TextBlock x:Name="FallbackName" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="FallbackDetails" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ProgressRing x:Name="Spinner" Width="32" Height="32" IsActive="False" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinFinder.App.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinFinder.App.ViewModels">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="14,14,0,4" />
        </Style>

        <Style x:Key="SidebarItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="SidebarItemTemplate" x:DataType="vm:SidebarItem">
            <Grid ColumnSpacing="10" Background="Transparent" Height="30"
                  AllowDrop="{x:Bind CanAcceptDrop}" DragOver="Item_DragOver" Drop="Item_Drop"
                  ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.ContextFlyout>
                    <MenuFlyout Opening="ItemMenu_Opening" />
                </Grid.ContextFlyout>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Visibility="{x:Bind IsNotTag}"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Ellipse Width="11" Height="11" Fill="{x:Bind TagBrush, Mode=OneWay}" Visibility="{x:Bind IsTag}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{x:Bind UsedPercent, Mode=OneWay}" Maximum="100" Height="3" MinHeight="3"
                                 Visibility="{x:Bind ShowUsage, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
        <StackPanel>
            <TextBlock Text="Favorites" Style="{StaticResource SectionHeader}" />
            <ListView x:Name="FavoritesList" ItemsSource="{x:Bind Sidebar.Favorites}"
                      ItemTemplate="{StaticResource SidebarItemTemplate}" ItemContainerStyle="{StaticResource SidebarItemStyle}"
                      SelectionMode="Single" IsItemClickEnabled="True" ItemClick="List_ItemClick"
                      CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                      DragOver="Favorites_DragOver" Drop="Favorites_Drop" />

            <TextBlock Text="Locations" Style="{StaticResource SectionHeader}" />
            <ListView x:Name="LocationsList" ItemsSource="{x:Bind Sidebar.Locations}"
                      ItemTemplate="{StaticResource SidebarItemTemplate}" ItemContainerStyle="{StaticResource SidebarItemStyle}"
                      SelectionMode="Single" IsItemClickEnabled="True" ItemClick="List_ItemClick" />

            <TextBlock Text="Tags" Style="{StaticResource SectionHeader}" />
            <ListView x:Name="TagsList" ItemsSource="{x:Bind Sidebar.Tags}"
                      ItemTemplate="{StaticResource SidebarItemTemplate}" ItemContainerStyle="{StaticResource SidebarItemStyle}"
                      SelectionMode="Single" IsItemClickEnabled="True" ItemClick="List_ItemClick" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinFinder.App.Views.BrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinFinder.App.ViewModels"
    xmlns:views="using:WinFinder.App.Views"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    >

    <UserControl.Resources>
        <ResourceDictionary>
        <!-- Finder-style selection: selected rows are filled with the Windows accent color (blue by
             default) with white text, instead of WinUI's faint gray and side pill. -->
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColorDark1}" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColorDark2}" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="White" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="White" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="White" />
                <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.28" />
                <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.36" />
                <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.44" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColorLight1}" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColorDark1}" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="White" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="White" />
                <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="White" />
                <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.35" />
                <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.45" />
                <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.55" />
            </ResourceDictionary>
            <!-- HighContrast keeps the system highlight colors. -->
        </ResourceDictionary.ThemeDictionaries>
        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>

        <Style x:Key="CompactListItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="IconGridItem" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <!-- Dimmed by opacity rather than a fixed gray, so it turns white with the row when selected. -->
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,2,8,2" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <DataTemplate x:Key="TagDotTemplate" x:DataType="media:Brush">
            <Ellipse Width="9" Height="9" Margin="-3,0,0,0" Fill="{x:Bind}"
                     Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="1" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" Margin="3,0,0,0" />
        </ItemsPanelTemplate>

        <!-- List view row -->
        <DataTemplate x:Key="ListRowTemplate" x:DataType="vm:FileItemViewModel">
            <Grid Height="26" Background="Transparent" Opacity="{x:Bind ItemOpacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind Layout.NameGrid, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.DateGrid, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.SizeGrid, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.KindGrid, Mode=OneWay}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.ColumnSpan="5" Margin="-6,1,-6,1" RadiusX="4" RadiusY="4" IsHitTestVisible="False"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.35"
                           Visibility="{x:Bind IsDropTarget, Mode=OneWay}" />
                <Grid ColumnSpacing="4" Padding="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="{x:Bind IndentWidth}" />
                    <Button Grid.Column="1" Width="16" Height="20" Padding="0" MinWidth="0" MinHeight="0"
                            Background="Transparent" BorderThickness="0" IsTabStop="False"
                            Visibility="{x:Bind CanExpand}" Click="Expander_Click">
                        <FontIcon Glyph="{x:Bind ExpanderGlyph, Mode=OneWay}" FontSize="9" />
                    </Button>
                    <Image Grid.Column="2" Width="16" Height="16" Source="{x:Bind Icon, Mode=OneWay}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{x:Bind IsNotRenaming, Mode=OneWay}"
                               PointerPressed="ItemName_PointerPressed" Tapped="ItemName_Tapped" />
                    <TextBox Grid.Column="3" x:Name="RenameBox" x:Load="{x:Bind IsRenaming, Mode=OneWay}"
                             Text="{x:Bind RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,1,4,1" MinHeight="22" VerticalAlignment="Center"
                             Loaded="RenameBox_Loaded" KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                    <ItemsControl Grid.Column="4" ItemsSource="{x:Bind TagBrushes, Mode=OneWay}" VerticalAlignment="Center"
                                  ItemTemplate="{StaticResource TagDotTemplate}" ItemsPanel="{StaticResource HorizontalPanel}" IsTabStop="False" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind ModifiedText, Mode=OneWay}" Style="{StaticResource SecondaryText}" />
                <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource SecondaryText}" />
                <TextBlock Grid.Column="3" Text="{x:Bind KindText, Mode=OneWay}" Style="{StaticResource SecondaryText}" />
                <TextBlock Grid.Column="4" Text="{x:Bind WhereText, Mode=OneWay}" Style="{StaticResource SecondaryText}"
                           Visibility="{x:Bind ShowWhere}" />
            </Grid>
        </DataTemplate>

        <!-- Icon view cell -->
        <DataTemplate x:Key="IconCellTemplate" x:DataType="vm:FileItemViewModel">
            <Grid>
            <Rectangle RadiusX="6" RadiusY="6" IsHitTestVisible="False"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.35"
                       Visibility="{x:Bind IsDropTarget, Mode=OneWay}" />
            <StackPanel Width="{x:Bind Layout.IconCellWidth, Mode=OneWay}" Padding="4,8,4,6" Spacing="4"
                        Opacity="{x:Bind ItemOpacity, Mode=OneWay}">
                <Image Width="{x:Bind Layout.IconSize, Mode=OneWay}" Height="{x:Bind Layout.IconSize, Mode=OneWay}"
                       Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                <Grid>
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" FontSize="12" Visibility="{x:Bind IsNotRenaming, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               PointerPressed="ItemName_PointerPressed" Tapped="ItemName_Tapped" />
                    <TextBox x:Name="RenameBox" x:Load="{x:Bind IsRenaming, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap"
                             Text="{x:Bind RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                             Loaded="RenameBox_Loaded" KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind TagBrushes, Mode=OneWay}" HorizontalAlignment="Center"
                              ItemTemplate="{StaticResource TagDotTemplate}" ItemsPanel="{StaticResource HorizontalPanel}" IsTabStop="False" />
            </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Column view row -->
        <DataTemplate x:Key="ColumnRowTemplate" x:DataType="vm:FileItemViewModel">
            <Grid Height="24" ColumnSpacing="6" Background="Transparent" Opacity="{x:Bind ItemOpacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.ColumnSpan="4" Margin="-6,0,-6,0" RadiusX="4" RadiusY="4" IsHitTestVisible="False"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.35"
                           Visibility="{x:Bind IsDropTarget, Mode=OneWay}" />
                <Image Width="16" Height="16" Source="{x:Bind Icon, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{x:Bind IsNotRenaming, Mode=OneWay}"
                           PointerPressed="ItemName_PointerPressed" Tapped="ItemName_Tapped" />
                <TextBox Grid.Column="1" x:Name="RenameBox" x:Load="{x:Bind IsRenaming, Mode=OneWay}"
                         Text="{x:Bind RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4,1,4,1" MinHeight="22" VerticalAlignment="Center"
                         Loaded="RenameBox_Loaded" KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                <ItemsControl Grid.Column="2" ItemsSource="{x:Bind TagBrushes, Mode=OneWay}" VerticalAlignment="Center"
                              ItemTemplate="{StaticResource TagDotTemplate}" ItemsPanel="{StaticResource HorizontalPanel}" IsTabStop="False" />
                <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="9" Visibility="{x:Bind IsFolder}" Opacity="0.7" />
            </Grid>
        </DataTemplate>

        <!-- One folder column -->
        <DataTemplate x:Key="FolderColumnTemplate" x:DataType="vm:ColumnViewModel">
            <Grid Width="{x:Bind Layout.ColumnWidth, Mode=OneWay}" BorderThickness="0,0,1,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <ListView x:Name="ColumnList"
                          ItemsSource="{x:Bind Contents.Items, Mode=OneWay}"
                          ItemTemplate="{StaticResource ColumnRowTemplate}"
                          ItemContainerStyle="{StaticResource CompactListItem}"
                          SelectionMode="Extended" Padding="0,4,0,4"
                          CanDragItems="True" AllowDrop="True"
                          SelectionChanged="Column_SelectionChanged"
                          GotFocus="Column_GotFocus"
                          KeyDown="Column_KeyDown"
                          PreviewKeyDown="Column_PreviewKeyDown"
                          DoubleTapped="Item_DoubleTapped"
                          RightTapped="Item_RightTapped"
                          ContainerContentChanging="ListItem_ContainerContentChanging"
                          DragItemsStarting="Items_DragItemsStarting"
                          DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop"
                          CharacterReceived="Items_CharacterReceived" />
                <ProgressRing IsActive="{x:Bind Contents.IsLoading, Mode=OneWay}" Width="20" Height="20"
                              VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False" />
                <TextBlock Text="{x:Bind Contents.Error, Mode=OneWay}" Visibility="{x:Bind Contents.HasError, Mode=OneWay}"
                           TextWrapping="Wrap" Margin="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <toolkit:PropertySizer Binding="{x:Bind Layout.ColumnWidth, Mode=TwoWay}" HorizontalAlignment="Right"
                                       Width="6" Minimum="140" Maximum="900" Background="Transparent" />
            </Grid>
        </DataTemplate>

        <!-- Preview column (selected file) -->
        <DataTemplate x:Key="PreviewColumnTemplate" x:DataType="vm:PreviewColumnViewModel">
            <ScrollViewer Width="300">
                <StackPanel Padding="20,24,20,20" Spacing="8">
                    <Image Source="{x:Bind Image, Mode=OneWay}" MaxWidth="220" MaxHeight="220" Stretch="Uniform" />
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind KindAndSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center" HorizontalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind TagBrushes}" HorizontalAlignment="Center"
                                  ItemTemplate="{StaticResource TagDotTemplate}" ItemsPanel="{StaticResource HorizontalPanel}" IsTabStop="False" />
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8" />
                    <TextBlock Text="Information" FontWeight="SemiBold" FontSize="12" />
                    <Grid ColumnSpacing="8" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Created" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Created}" FontSize="12" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Modified" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Modified}" FontSize="12" TextAlignment="Right" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <views:ColumnTemplateSelector x:Key="ColumnSelector"
                                      Folder="{StaticResource FolderColumnTemplate}"
                                      Preview="{StaticResource PreviewColumnTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Finder-style search scope bar -->
        <StackPanel Orientation="Horizontal" Spacing="10" Padding="14,8,14,6"
                    Visibility="{x:Bind Tab.IsSearch, Mode=OneWay}">
            <TextBlock Text="Search:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <toolkit:Segmented x:Name="ScopeSelector" SelectionChanged="Scope_SelectionChanged">
                <toolkit:SegmentedItem Content="This PC" />
                <toolkit:SegmentedItem Content="{x:Bind Tab.SearchScopeName, Mode=OneWay}" />
            </toolkit:Segmented>
        </StackPanel>

        <!-- List view -->
        <Grid Grid.Row="1" Visibility="{x:Bind Tab.IsListView, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="16,4,12,2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind Layout.NameGrid, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.DateGrid, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.SizeGrid, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Layout.KindGrid, Mode=OneWay}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource HeaderButton}" Tag="Name" Click="Header_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Name" />
                        <FontIcon FontSize="9" Glyph="{x:Bind SortGlyph(Tab.SortKey, Tab.SortDescending, 0), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <toolkit:PropertySizer Binding="{x:Bind Layout.NameWidth, Mode=TwoWay}" HorizontalAlignment="Right" Width="6" Minimum="140" Maximum="1200" />
                <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Tag="Modified" Click="Header_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Date Modified" />
                        <FontIcon FontSize="9" Glyph="{x:Bind SortGlyph(Tab.SortKey, Tab.SortDescending, 1), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <toolkit:PropertySizer Grid.Column="1" Binding="{x:Bind Layout.DateWidth, Mode=TwoWay}" HorizontalAlignment="Right" Width="6" Minimum="80" Maximum="600" />
                <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Tag="Size" Click="Header_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Size" />
                        <FontIcon FontSize="9" Glyph="{x:Bind SortGlyph(Tab.SortKey, Tab.SortDescending, 2), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <toolkit:PropertySizer Grid.Column="2" Binding="{x:Bind Layout.SizeWidth, Mode=TwoWay}" HorizontalAlignment="Right" Width="6" Minimum="50" Maximum="400" />
                <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Tag="Kind" Click="Header_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Kind" />
                        <FontIcon FontSize="9" Glyph="{x:Bind SortGlyph(Tab.SortKey, Tab.SortDescending, 3), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <toolkit:PropertySizer Grid.Column="3" Binding="{x:Bind Layout.KindWidth, Mode=TwoWay}" HorizontalAlignment="Right" Width="6" Minimum="60" Maximum="600" />
                <TextBlock Grid.Column="4" Text="Where" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind Tab.ShowWhereColumn, Mode=OneWay}" />
            </Grid>
            <ListView x:Name="FileList" Grid.Row="1"
                      ItemsSource="{x:Bind Tab.Tree.FlatItems, Mode=OneWay}"
                      ItemTemplate="{StaticResource ListRowTemplate}"
                      ItemContainerStyle="{StaticResource CompactListItem}"
                      SelectionMode="Extended" Padding="0,4,0,8"
                      CanDragItems="True" AllowDrop="True"
                      SelectionChanged="Items_SelectionChanged"
                      KeyDown="FileList_KeyDown"
                      DoubleTapped="Item_DoubleTapped"
                      RightTapped="Item_RightTapped"
                      ContainerContentChanging="ListItem_ContainerContentChanging"
                      DragItemsStarting="Items_DragItemsStarting"
                      DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop"
                      CharacterReceived="Items_CharacterReceived" />
        </Grid>

        <!-- Icon view -->
        <GridView x:Name="IconGrid" Grid.Row="1" Padding="12,8,12,8"
                  Visibility="{x:Bind Tab.IsIconView, Mode=OneWay}"
                  ItemsSource="{x:Bind Tab.Contents.Items, Mode=OneWay}"
                  ItemTemplate="{StaticResource IconCellTemplate}"
                  ItemContainerStyle="{StaticResource IconGridItem}"
                  SelectionMode="Extended"
                  CanDragItems="True" AllowDrop="True"
                  SelectionChanged="Items_SelectionChanged"
                  DoubleTapped="Item_DoubleTapped"
                  RightTapped="Item_RightTapped"
                  ContainerContentChanging="IconGrid_ContainerContentChanging"
                  DragItemsStarting="Items_DragItemsStarting"
                  DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop"
                  CharacterReceived="Items_CharacterReceived" />

        <!-- Column view -->
        <ScrollViewer x:Name="ColumnScroller" Grid.Row="1"
                      Visibility="{x:Bind Tab.IsColumnView, Mode=OneWay}"
                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ColumnsHost" ItemsSource="{x:Bind Tab.Columns.Columns}"
                          ItemTemplateSelector="{StaticResource ColumnSelector}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading / error / empty states for list and icon views -->
        <ProgressRing Grid.Row="1" Width="28" Height="28" IsHitTestVisible="False"
                      IsActive="{x:Bind ShowListSpinner(Tab.Contents.IsLoading, Tab.IsColumnView), Mode=OneWay, FallbackValue=False}" />
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                   MaxWidth="420" TextAlignment="Center" IsHitTestVisible="False"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind Tab.Contents.Error, Mode=OneWay}"
                   Visibility="{x:Bind Tab.Contents.HasError, Mode=OneWay, FallbackValue=Collapsed}" />
    </Grid>
</UserControl>

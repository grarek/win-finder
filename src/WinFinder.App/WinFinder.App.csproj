<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WinFinder.App</RootNamespace>
    <AssemblyName>WinFinder</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinFinder.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- MVVMTK0045: [ObservableProperty] on fields isn't Native-AOT/trimming compatible for WinRT;
         the fix (partial properties) needs C# 13 / .NET 9. WinFinder ships ReadyToRun, not
         Native AOT or trimmed, so this doesn't apply. Revisit if PublishAot/PublishTrimmed is enabled. -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <!-- WinUI needs a concrete platform. Default to x64 so `dotnet build`/`dotnet run`
       work without -p:Platform (dotnet run ignores it when locating the exe). -->
  <PropertyGroup Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">
    <Platform>x64</Platform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64' and '$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64' and '$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinFinder.Core\WinFinder.Core.csproj" />
  </ItemGroup>

  <!-- GitHub repository ("owner/name") the in-app updater reads releases from. Forks can override:
       dotnet publish -p:UpdateRepository=you/your-fork -->
  <PropertyGroup>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">grarek/win-finder</UpdateRepository>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by tools\make-icon.ps1. The .ico is embedded in the exe (Explorer, taskbar
         pins) and copied next to it for the window's title bar / Alt+Tab icon. -->
    <Content Include="Assets\WinFinder.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\WinFinder-256.png" />
  </ItemGroup>

</Project>

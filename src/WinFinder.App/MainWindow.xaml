<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinFinder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinFinder.App.ViewModels"
    xmlns:views="using:WinFinder.App.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="WinFinder">

    <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.RowDefinitions>
            <!-- MinHeight is set in code to the caption buttons' height so they never overhang the toolbar. -->
            <RowDefinition x:Name="TitleRow" Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tab strip in the title bar -->
        <TabView x:Name="TabStrip" Grid.Row="0"
                 TabItemsSource="{x:Bind ViewModel.Tabs}"
                 TabWidthMode="Equal" CloseButtonOverlayMode="OnPointerOver"
                 IsAddTabButtonVisible="True"
                 CanDragTabs="True" CanReorderTabs="True" AllowDropTabs="True"
                 AddTabButtonClick="TabStrip_AddTabButtonClick"
                 TabCloseRequested="TabStrip_TabCloseRequested"
                 SelectionChanged="TabStrip_SelectionChanged"
                 TabDragStarting="TabStrip_TabDragStarting"
                 TabStripDragOver="TabStrip_TabStripDragOver"
                 TabStripDrop="TabStrip_TabStripDrop"
                 TabDroppedOutside="TabStrip_TabDroppedOutside"
                 Padding="0" VerticalAlignment="Bottom">
            <TabView.TabStripHeader>
                <Grid Width="6" />
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="DragRegion" Background="Transparent" MinWidth="160" />
            </TabView.TabStripFooter>
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:BrowserTabViewModel">
                    <TabViewItem Header="{x:Bind Title, Mode=OneWay}"
                                 ToolTipService.ToolTip="{x:Bind TitleTooltip, Mode=OneWay}"
                                 AllowDrop="True"
                                 DragOver="TabItem_DragOver" DragLeave="TabItem_DragLeave" Drop="TabItem_Drop">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE8B7;" />
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="10,6,12,6" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" Click="Back_Click"
                        IsEnabled="{x:Bind ViewModel.SelectedTab.CanGoBack, Mode=OneWay, FallbackValue=False}"
                        ToolTipService.ToolTip="Back (Alt+Left)">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource ToolbarButton}" Click="Forward_Click"
                        IsEnabled="{x:Bind ViewModel.SelectedTab.CanGoForward, Mode=OneWay, FallbackValue=False}"
                        ToolTipService.ToolTip="Forward (Alt+Right)">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="Up_Click" ToolTipService.ToolTip="Enclosing folder (Alt+Up)">
                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedTab.Title, Mode=OneWay, FallbackValue=''}"
                       FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" MaxWidth="360" />

            <toolkit:Segmented Grid.Column="3" x:Name="ViewModeSelector"
                               SelectedIndex="{x:Bind ViewModel.ViewModeIndex, Mode=TwoWay}"
                               VerticalAlignment="Center">
                <toolkit:SegmentedItem ToolTipService.ToolTip="as Icons (Ctrl+1)">
                    <toolkit:SegmentedItem.Icon>
                        <PathIcon Data="M0,0 H6 V6 H0 Z M8,0 H14 V6 H8 Z M0,8 H6 V14 H0 Z M8,8 H14 V14 H8 Z" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
                <toolkit:SegmentedItem ToolTipService.ToolTip="as List (Ctrl+2)">
                    <toolkit:SegmentedItem.Icon>
                        <PathIcon Data="M0,1 H14 V3 H0 Z M0,6 H14 V8 H0 Z M0,11 H14 V13 H0 Z" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
                <toolkit:SegmentedItem ToolTipService.ToolTip="as Columns (Ctrl+3)">
                    <toolkit:SegmentedItem.Icon>
                        <PathIcon Data="M0,0 H4 V14 H0 Z M5,0 H9 V14 H5 Z M10,0 H14 V14 H10 Z" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
            </toolkit:Segmented>

            <DropDownButton Grid.Column="4" Style="{StaticResource ToolbarDropDown}" ToolTipService.ToolTip="Tags">
                <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="TagsMenu" Placement="BottomEdgeAlignedRight" Opening="TagsMenu_Opening" />
                </DropDownButton.Flyout>
            </DropDownButton>

            <DropDownButton Grid.Column="5" Style="{StaticResource ToolbarDropDown}" ToolTipService.ToolTip="More actions">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="ActionsMenu" Placement="BottomEdgeAlignedRight" Opening="ActionsMenu_Opening" />
                </DropDownButton.Flyout>
            </DropDownButton>

            <AutoSuggestBox Grid.Column="6" x:Name="SearchBox" PlaceholderText="Search" Width="220"
                            VerticalAlignment="Center" QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted" />
        </Grid>

        <!-- Sidebar + browser -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="{x:Bind SidebarWidth, Mode=OneWay}">
                <views:SidebarView x:Name="Sidebar" />
                <toolkit:PropertySizer Binding="{x:Bind SidebarWidth, Mode=TwoWay}" HorizontalAlignment="Right"
                                       Width="6" Minimum="150" Maximum="420" Background="Transparent" />
            </Grid>
            <Grid x:Name="BrowserHost" Grid.Column="1"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" />
        </Grid>

        <!-- Path bar + status bar -->
        <Grid Grid.Row="3" Padding="12,3,12,4" ColumnSpacing="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <BreadcrumbBar x:Name="PathBar" ItemsSource="{x:Bind ViewModel.SelectedTab.PathSegments, Mode=OneWay}"
                           ItemClicked="PathBar_ItemClicked" VerticalAlignment="Center" FontSize="12" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedTab.StatusText, Mode=OneWay, FallbackValue=''}"
                       FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Slider Grid.Column="2" x:Name="IconSizeSlider" Width="120" Minimum="32" Maximum="256" StepFrequency="8"
                    Value="{x:Bind Layout.IconSize, Mode=TwoWay}" ValueChanged="IconSizeSlider_ValueChanged"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Icon size"
                    Visibility="{x:Bind ViewModel.SelectedTab.IsIconView, Mode=OneWay, FallbackValue=Collapsed}" />
        </Grid>

        <!-- Quick Look overlay spans the whole window -->
        <views:QuickLookOverlay x:Name="QuickLook" Grid.RowSpan="4" Visibility="Collapsed" />
    </Grid>
</Window>
